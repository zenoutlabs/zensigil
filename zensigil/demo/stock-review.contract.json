{
  "title": "Stock review input",
  "description": "Use available stock and average daily sales for the same unit of measure. All records must be valid before review runs.",
  "type": "object",
  "required": ["policy", "inventory"],
  "additionalProperties": false,
  "properties": {
    "policy": {
      "type": "object",
      "required": ["review_below_days", "target_days"],
      "additionalProperties": false,
      "properties": {
        "review_below_days": {"type": "integer", "minimum": 1, "maximum": 3650, "description": "Review products with fewer than this many whole days of stock."},
        "target_days": {"type": "integer", "minimum": 1, "maximum": 3650, "description": "Aim for at least this many whole days of stock after the proposed reorder."}
      }
    },
    "inventory": {
      "type": "array", "minItems": 1, "maxItems": 400, "uniqueBy": "sku",
      "items": {
        "type": "object", "required": ["sku", "stock", "discontinued"],
        "properties": {
          "sku": {"type": "string", "minLength": 1, "maxLength": 80},
          "name": {"type": "string", "minLength": 1, "maxLength": 160},
          "stock": {"type": "integer", "minimum": 0},
          "daily_sales": {"type": ["number", "null"], "minimum": 0},
          "discontinued": {"type": "boolean"}
        }
      }
    }
  }
}
