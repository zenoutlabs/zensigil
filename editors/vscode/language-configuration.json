{
  "comments": {"lineComment": "#"},
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [{"open": "(", "close": ")"}, {"open": "[", "close": "]"}, {"open": "{", "close": "}"}, {"open": "\"", "close": "\"", "notIn": ["string", "comment"]}],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["{", "}"], ["\"", "\""]],
  "indentationRules": {"increaseIndentPattern": "^\\s*(?:fn|when|otherwise|for|while|rule|test)\\b.*:\\s*(?:#.*)?$"}
}
