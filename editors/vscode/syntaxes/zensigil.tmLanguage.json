{
  "name": "ZenSigil",
  "scopeName": "source.zensigil",
  "patterns": [
    {
      "name": "comment.line.number-sign.zensigil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.zensigil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.zensigil",
          "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9A-Fa-f]{4})"
        }
      ]
    },
    {
      "name": "entity.name.function.zensigil",
      "match": "(?<=fn )\\b[A-Za-z_][A-Za-z_0-9]*"
    },
    {
      "name": "keyword.control.zensigil",
      "match": "\\b(?:let|var|set|say|emit|when|otherwise|for|in|fn|return|rule|propose|require|while|break|continue|choose|then|test|use|as|export|and|or|not)\\b"
    },
    {
      "name": "constant.language.zensigil",
      "match": "\\b(?:true|false|null)\\b"
    },
    {
      "name": "support.type.zensigil",
      "match": "\\b(?:any|number|integer|string|boolean|list|record|function|namespace|null)\\b"
    },
    {
      "name": "constant.numeric.zensigil",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b"
    },
    {
      "name": "keyword.operator.zensigil",
      "match": "\\?\\?|->|=>|==|!=|<=|>=|[+*/%<>=|\\-]"
    }
  ]
}
